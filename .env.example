# Copy this file to `.env` (which is gitignored) and fill in real values locally.
# NEVER commit `.env` or paste real keys into issues, chat, or memory files.

# SEC EDGAR requires a descriptive User-Agent with contact info on every request.
# Format suggested by the SEC: "Organization Name contact@email"
SEC_USER_AGENT="CMU i2ai Team 5 your-andrew-id@andrew.cmu.edu"

# Optional — only if the team decides to use these sources (see docs/part1-sourcing/ethics_memo.md)
NEWSAPI_KEY=
LLM_API_KEY=

# AI agent (src/agent/). DeepSeek, OpenAI-compatible API. Only public SEC text is sent (see docs/part4-agent/agent_design.md).
DEEPSEEK_API_KEY=
# Optional overrides
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_MODEL_SNAPSHOT=DeepSeek-V4.1-Flash-1017
# AGENT_LLM_PROVIDER=mock   # offline dry run, no key needed
